rules_version = '2';

// PMC Question Bank — Firestore security rules
// Access model: a signed-in user (email + password, account created by an
// admin — no self sign-up) may read/write question data only if they have
// a document in `teachers/{their email}`. Admin-only actions (post-test
// statistics) additionally require role == "admin" on that doc. Teacher
// documents/logins are managed by admins from the app's Admin tab (Manage
// Teachers), or by hand in the Firebase console as a fallback.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.token.email));
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/teachers/$(request.auth.token.email)).data.role == "admin";
    }

    // Each teacher can read their own allow-list entry (to check status);
    // admins can read the full list and create/update/delete entries —
    // this is what powers the Admin tab's "Manage Teachers" UI.
    match /teachers/{email} {
      allow read: if isSignedIn() && (request.auth.token.email == email || isAdmin());
      allow create, update: if isAdmin() &&
        email == email.lower() &&
        request.resource.data.role in ["teacher", "admin"];
      allow delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow read, create, update: if isTeacher();
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read, create: if isTeacher();
        allow update, delete: if isAdmin();
      }

      match /ratings/{ratingId} {
        // a teacher may only write a rating document whose authorEmail
        // field matches their own signed-in email — prevents one teacher
        // overwriting another's rating even though ratingId is client-set.
        allow read: if isTeacher();
        allow write: if isTeacher() &&
          request.resource.data.authorEmail == request.auth.token.email;
      }

      match /stats/{statId} {
        allow read: if isTeacher();
        allow write: if isAdmin();
      }
    }
  }
}

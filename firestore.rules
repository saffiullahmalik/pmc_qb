rules_version = '2';

// PMC Question Bank — Firestore security rules
// Access model: a signed-in user (email + password, account created by an
// admin — no self sign-up) may read/write question data only if they have
// a document in `teachers/{their email}`. Admin-only actions (post-test
// statistics) additionally require role == "admin" on that doc. Teacher
// documents/logins are managed by admins from the app's Admin tab (Manage
// Teachers), or by hand in the Firebase console as a fallback.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.token.email));
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/teachers/$(request.auth.token.email)).data.role == "admin";
    }

    function isQBLeadOrAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/teachers/$(request.auth.token.email)).data.role in ["qb_lead", "admin"];
    }

    // Each teacher can read their own allow-list entry (to check status);
    // admins can read the full list and create/update/delete entries —
    // this is what powers the Admin tab's "Manage Teachers" UI.
    match /teachers/{email} {
      allow read: if isSignedIn() && (request.auth.token.email == email || isAdmin());
      allow create, update: if isAdmin() &&
        email == email.lower() &&
        request.resource.data.role in ["teacher", "qb_lead", "admin"];
      allow delete: if isAdmin();
    }

    match /contests/{contestId} {
      allow read, create, update: if isTeacher();
      allow delete: if isAdmin();
    }

    // Admins design workload assignments; every teacher can read the
    // collection to see their own quota/progress on the Workload tab.
    match /assignments/{assignmentId} {
      allow read: if isTeacher();
      allow create, update, delete: if isAdmin();
    }

    // Admin-added books/chapters, merged with the hardcoded curriculum at
    // read time in the app — additive only, never edits the built-in data.
    match /curriculumExtra/{entryId} {
      allow read: if isTeacher();
      allow create, update, delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if isTeacher();
      // Setting a question's status to "finalized" (locking it) is
      // restricted to QB Leads/admins.
      allow create: if isTeacher() &&
        (request.resource.data.status != "finalized" || isQBLeadOrAdmin());
      // Tagging a question with contest usage (usedIn) is usage tracking,
      // not content editing — any teacher may do this even on a locked
      // question, since building a contest from locked questions is an
      // everyday, non-admin workflow (see Contests tab).
      function isUsedInOnlyChange() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["usedIn", "updatedAt"]);
      }
      // Once a question IS locked, only an admin may touch it further,
      // except a QB Lead may still unlock it (move it back off "finalized")
      // — matches the app's lock model: a QB Lead can lock/unlock, but
      // can't edit content while it stays locked; admin can always edit.
      allow update: if isTeacher() && (
        isUsedInOnlyChange() ||
        (resource.data.status != "finalized"
          ? (request.resource.data.status != "finalized" || isQBLeadOrAdmin())
          : (isAdmin() || (isQBLeadOrAdmin() && request.resource.data.status != "finalized")))
      );
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read, create: if isTeacher();
        allow update, delete: if isAdmin();
      }

      match /ratings/{ratingId} {
        // a teacher may only write a rating document whose authorEmail
        // field matches their own signed-in email — prevents one teacher
        // overwriting another's rating even though ratingId is client-set.
        allow read: if isTeacher();
        allow write: if isTeacher() &&
          request.resource.data.authorEmail == request.auth.token.email;
      }

      match /stats/{statId} {
        allow read: if isTeacher();
        allow write: if isAdmin();
      }
    }
  }
}

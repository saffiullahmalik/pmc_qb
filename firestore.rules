rules_version = '2';

// PMC Question Bank — Firestore security rules
// Access model: a signed-in user (email + password, account created by an
// admin — no self sign-up) may read/write question data only if they have
// a document in `teachers/{their email}`. Admin-only actions (post-test
// statistics) additionally require role == "admin" on that doc. Teacher
// documents/logins are managed by admins from the app's Admin tab (Manage
// Teachers), or by hand in the Firebase console as a fallback.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.token.email));
    }

    // "external_reviewer" is a read-and-comment-only role (an outside
    // reviewer who spot-checks random questions, including locked ones, and
    // leaves feedback for an admin to act on) -- isTeacher() stays true for
    // them (so they can read everything and create comments), but content
    // actions (creating/editing questions, contests) require this instead.
    function isContentTeacher() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/teachers/$(request.auth.token.email)).data.role in ["teacher", "qb_lead", "admin"];
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/teachers/$(request.auth.token.email)).data.role == "admin";
    }

    function isQBLeadOrAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/teachers/$(request.auth.token.email)).data.role in ["qb_lead", "admin"];
    }

    // Any signed-in approved teacher can read the full roster -- every
    // teacher's client (not just admins) needs this to balanced-randomly
    // pick a peer reviewer from the full team (pickReviewer() in
    // index.html) and to compute the gamify bar's team-average comparison;
    // only admins can create/update/delete entries — this is what powers
    // the Admin tab's "Manage Teachers" UI.
    match /teachers/{email} {
      allow read: if isTeacher();
      allow create, update: if isAdmin() &&
        email == email.lower() &&
        request.resource.data.role in ["teacher", "qb_lead", "admin", "external_reviewer", "uploader"];
      allow delete: if isAdmin();
    }

    match /contests/{contestId} {
      allow read: if isTeacher();
      // "uploader" (view-only, Upload-tab-only role) can mark questions
      // uploaded / a paper's upload work complete -- that's specifically
      // an update touching only uploadStatus/quilgoComplete, never contest
      // create or any other field (name/level/day/slot/questionIds).
      function isUploadOnlyChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["uploadStatus", "quilgoComplete"]);
      }
      allow create: if isContentTeacher();
      allow update: if isContentTeacher() || (isTeacher() && isUploadOnlyChange());
      allow delete: if isAdmin();
    }

    // Admins design workload assignments; every teacher can read the
    // collection to see their own quota/progress on the Workload tab.
    match /assignments/{assignmentId} {
      allow read: if isTeacher();
      allow create, update, delete: if isAdmin();
    }

    // Admin-added books/chapters, merged with the hardcoded curriculum at
    // read time in the app — additive only, never edits the built-in data.
    match /curriculumExtra/{entryId} {
      allow read: if isTeacher();
      allow create, update, delete: if isAdmin();
    }

    // Admin-adjustable daily creation/review caps (Admin tab's "Daily
    // limits" form) and any other future global settings docs.
    match /settings/{id} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }

    // Append-only audit trail (Admin tab's Activity Log). Any signed-in
    // teacher can write an entry about an action they just took; only
    // admins can read the trail back -- it's an accountability tool for
    // admins, not a feed for every teacher (see the separate "Recently
    // posted" panel on the Bank tab for that).
    match /activityLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isTeacher();
      allow update, delete: if false;
    }

    match /questions/{questionId} {
      allow read: if isTeacher();
      // Setting a question's status to "finalized" (locking it) is
      // restricted to QB Leads/admins; creating content at all requires
      // isContentTeacher() -- an external reviewer reads and comments only.
      allow create: if isContentTeacher() &&
        (request.resource.data.status != "finalized" || isQBLeadOrAdmin());
      // Tagging a question with contest usage (usedIn) or liking it is
      // usage/engagement tracking, not content editing — any teacher may do
      // this even on a locked question, since building a contest from locked
      // questions (Contests tab) and liking a locked question are both
      // everyday, non-admin actions.
      function isMetadataOnlyChange() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["usedIn", "updatedAt", "likes"]);
      }
      // Once a question IS locked, only an admin may touch it further,
      // except a QB Lead may still unlock it (move it back off "finalized")
      // — matches the app's lock model: a QB Lead can lock/unlock, but
      // can't edit content while it stays locked; admin can always edit.
      // The content-edit branch requires isContentTeacher() -- an external
      // reviewer can still flip isMetadataOnlyChange() (e.g. a like).
      allow update: if isTeacher() && (
        isMetadataOnlyChange() ||
        (isContentTeacher() && (resource.data.status != "finalized"
          ? (request.resource.data.status != "finalized" || isQBLeadOrAdmin())
          : (isAdmin() || (isQBLeadOrAdmin() && request.resource.data.status != "finalized"))))
      );
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read, create: if isTeacher();
        allow update, delete: if isAdmin();
      }

      match /ratings/{ratingId} {
        // a teacher may only write a rating document whose authorEmail
        // field matches their own signed-in email — prevents one teacher
        // overwriting another's rating even though ratingId is client-set.
        allow read: if isTeacher();
        allow write: if isTeacher() &&
          request.resource.data.authorEmail == request.auth.token.email;
      }

      match /stats/{statId} {
        allow read: if isTeacher();
        allow write: if isAdmin();
      }
    }
  }
}
